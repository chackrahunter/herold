<?xml version="1.0" encoding="utf-8"?>
<!-- App-Symbol: Herzschlagkurve in einem Ring. Als Vektor, damit es auf
     jeder Aufloesung scharf bleibt und ohne AndroidX auskommt. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- Ring -->
    <path
        android:strokeColor="#FF3B5B"
        android:strokeWidth="5"
        android:fillColor="#00000000"
        android:pathData="M54,24 a30,30 0 1,0 0.1,0 z" />

    <!-- Herzschlaglinie -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M32,54 L41,54 L45,42 L51,68 L57,48 L61,54 L76,54" />
</vector>
